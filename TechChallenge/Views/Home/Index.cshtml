@{
    // Define o título da página que será exibido na aba do navegador
    ViewData["Title"] = "TechChallenge";
}

<!-- Container principal da página -->
<div class="container py-3">
    <!-- Seção principal (cabeçalho da página) -->
    <section class="text-center mb-10">

        <!-- Saudação acima do título secundário -->
        <p class="text-uppercase fw-semibold text-primary mb-2">
            Olá, bem-vindo
        </p>

        <!-- Texto pequeno acima do título -->
        <p class="text-uppercase fw-semibold text-primary mb-4">
            Plataforma estudantil
        </p>

        <!-- Título principal -->
        <h1 class="display-1 fw-bold">
            TechChallenge
        </h1>

        <!-- Descrição da plataforma -->
        <p class="lead text-muted text-center mx-auto" style="max-width: 720px;">
            Plataforma de Projetos e Inovação Estudantil <br> para transformar ideias em projetos reais.
        </p>

    </section>

    <!-- Seção dos cartões -->
    <!-- row = cria uma linha no Bootstrap -->
    <!-- g-4 = espaço entre as colunas -->
    <!-- align-items-stretch = faz todos os cards ficarem da mesma altura -->
    <section class="row g-3 align-items-stretch mb-5">

        <!-- Primeiro cartão -->
        <!--
            col-12 = ocupa toda a largura em celular
            col-md-6 = metade da largura em tablets
            col-lg-4 = 1/3 da largura em computadores
        -->
        <div class="col-12 col-md-6 col-lg-4">

            <!-- Card -->
            <div class="card h-100 shadow-sm border-0">

                <!-- Corpo do card -->
                <div class="card-body p-4">

                    <!-- Ícone -->
                    <div class="fs-2 mb-3">
                        👥
                    </div>

                    <!-- Título -->
                    <h2 class="h4 fw-bold">
                        Crie equipes e projetos
                    </h2>

                    <!-- Texto -->
                    <p class="text-muted mb-0">
                        Organize times para tirar ideias do papel e acompanhar cada etapa do desenvolvimento.
                    </p>

                </div>
            </div>
        </div>

        <!-- Segundo cartão -->
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="fs-2 mb-3">
                        🏁
                    </div>

                    <h2 class="h4 fw-bold">
                        Participe de desafios
                    </h2>

                    <p class="text-muted mb-0">
                        Encontre desafios, submeta soluções e acompanhe o progresso dos projetos em um só lugar.
                    </p>

                </div>
            </div>
        </div>

        <!-- Terceiro cartão -->
        <div class="col-12 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="fs-2 mb-3">
                        📊
                    </div>

                    <h2 class="h4 fw-bold">
                        Ganhe pontos e suba no ranking
                    </h2>

                    <p class="text-muted mb-0">
                        Valorize a participação com pontuação e descubra quem está se destacando na plataforma.
                    </p>

                </div>
            </div>
        </div>

    </section>

    <!-- Seção final (chamada para o usuário) -->
    <section class="text-center bg-light rounded-4 p-4 p-md-5">

        <!-- Frase principal -->
        <p class="fs-5 mb-2">
            O lugar onde suas ideias viram projetos reais
        </p>

        <!-- Texto complementar -->
        <p class="text-muted mb-0">
            Um ambiente pensado para colaboração, inovação e aprendizado na prática.
        </p>
        

    </section>

</div>